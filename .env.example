# =============================================================================
# TetraCore Worker — Environment Variables
# =============================================================================
# Скопіюйте цей файл у .env та заповніть реальними значеннями.
# cp .env.example .env

# ---- Hub connection ----
# WebSocket URL хабу, до якого підключається воркер
HUB_URL=ws://localhost:8000/ws
# Токен автентифікації для підключення до хабу
AUTH_TOKEN=
# Вимагати subprotocol при WebSocket handshake
HUB_ENFORCE_SUBPROTOCOL=true

# ---- Worker ----
# Унікальний ідентифікатор воркера (залишіть порожнім для auto-generate)
WORKER_ID=
# Максимальна кількість одночасно виконуваних дій
WORKER_CONCURRENCY=10
# Максимум невдалих спроб реконекту (0 = необмежено)
WORKER_MAX_HUB_RECONNECT_FAILURES=0

# ---- Redis ----
# Redis connection URL
REDIS_URL=redis://localhost:6379/0
# Пароль Redis (залишіть порожнім якщо без паролю)
REDIS_PASSWORD=
# Увімкнути TLS для Redis
REDIS_TLS_ENABLED=false

# ---- MySQL ----
# MySQL Data Source Name
MYSQL_DSN=user:password@tcp(localhost:3306)/tetracore?charset=utf8mb4&parseTime=True&loc=UTC

# ---- Telegram ----
# Bot token для Telegram API (використовується у check_user_admin action)
BOT_TOKEN=

# ---- Logging ----
# Рівень логування: trace, debug, info, warn, error, fatal, panic
LOG_LEVEL=info
# Формат логів: json або console
LOG_FORMAT=json

# ---- Metrics ----
# Увімкнути Prometheus метрики
METRICS_ENABLED=false
# Порт для metrics endpoint
METRICS_PORT=9090
